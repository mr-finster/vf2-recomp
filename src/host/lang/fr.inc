T(D_GPU_QUALITY, "Qualité GPU")
T(D_GPU_QUALITY_HELP, "Exacte dessine la 3D sur le GPU pixel pour pixel comme le CPU. Rapide prend des raccourcis\xC2\xA0: plus vite sur une carte graphique lente, avec de légères différences dans le détail des textures et sur les bords.")
