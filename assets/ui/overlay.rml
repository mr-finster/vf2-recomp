<rml>
<head>
	<title>Overlay</title>
	<style>
		/* drawn over the game: the frames per second, small, at the top right (Display > Show FPS) */
		body { width: 100%; height: 100%; font-family: "Barlow Condensed"; pointer-events: none; }
		#fps {
			position: absolute;
			right: 18dp;
			top: 12dp;
			font-size: 22dp;
			font-weight: 600;
			color: #ffd23f;
			font-effect: outline(2dp #0b1430);
		}
		/* a notice that comes and goes, at the bottom right (out of the menu's way and the HUD's) */
		#toast {
			position: absolute;
			right: 24dp;
			bottom: 40dp;
			max-width: 560dp;
		}
		#toast span {
			display: block;
			padding: 8dp 20dp;
			font-size: 22dp;
			font-weight: 700;
			font-style: italic;
			text-align: right;
			color: #0b1430;
			decorator: horizontal-gradient(#ffd23f #ff8f1f);
		}
	</style>
</head>
<body><div id="fps"></div><div id="toast"></div></body>
</rml>
