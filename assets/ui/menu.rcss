/* The in-game menu. Sizes are in dp: the host sets 1dp = 1/720 of the window's height (or 1/1280 of its width,
   if that's less: the panel is laid out for 720dp of height or more).
   Gradients are the vertex-colour kind (horizontal-gradient): the SDL renderer has no shaders.

   One column with a fixed space for each part, so nothing overlaps whatever the page:
     top 18.5 + title 40.8 + crumb 21.6 + rows 21 x 24.6 = 517 + note 6.2 + 61.6 (4 lines) + hint 6.2
     + 16.9 + version 3.1 + 13.9 = 706dp of 720. Every page fits whole, so none scrolls (a scroll can't be
     seen: the rows below looked missing); the longest, Display on Windows, has 20 and Back. menutest fails
     a page that doesn't fit. A long value is cut, never drawn over its label.
   (Each size 0.77 of what it was up to v0.1.19, when 14 rows fit: the same look, a size smaller, for
   Display's 21.) */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 18.5dp;
	color: #dfe7fb;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#040818f2 #04081850);
}

#panel {
	position: absolute;
	left: 9%;
	top: 18.5dp;
	width: 400.4dp;
}

#title {
	font-size: 35.4dp;
	font-weight: bold;
	font-style: italic;
	color: #ffd23f;
	height: 37dp;
	line-height: 37dp;
	padding-bottom: 1.5dp;
	border-bottom: 2.3dp #ffd23f;
}

#crumb {
	height: 18.5dp;
	line-height: 18.5dp;
	margin-bottom: 3.1dp;
	font-size: 13.9dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
	overflow: hidden;
}

#rows {
	max-height: 517dp;      /* 21 rows; a longer page would scroll, keeping the selected row in view */
	overflow-y: hidden;
}

.row {
	display: flex;
	height: 22.3dp;
	line-height: 22.3dp;
	padding: 0 12.3dp;
	margin-bottom: 2.3dp;
	font-size: 17.7dp;
	color: #c3cff0;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 0 auto;
	margin-right: 13.9dp;
}

.row .value {
	flex: 0 1 auto;
	overflow: hidden;
	color: #ffd23f;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ffd23f #ff8f1f);
	color: #0b1430;
	padding-left: 21.6dp;
}

.row.selected .value { color: #0b1430; }

.row .arrow { color: #8fa3d6; }
.row.selected .arrow { color: #0b1430; }

.row.info {
	height: 20dp;
	line-height: 20dp;
	font-size: 14.6dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #dfe7fb; }

/* a row belonging to the one above it */
.row.sub { padding-left: 30.8dp; font-size: 16.2dp; }
.row.sub .label { color: #9fb0dc; }
.row.sub.selected { padding-left: 40dp; }
.row.sub.selected .label { color: #0b1430; }

/* a line under its row: a mistake to put right (red), or how it's going (green) */
.row.error, .row.good {
	height: auto;
	line-height: 18.5dp;
	padding-left: 40dp;
	font-size: 13.9dp;
	color: #ff6b5a;
	white-space: normal;   /* (a long one, a failed join's what to do, wraps) */
}
.row.error .label, .row.good .label { flex: 1 1 auto; margin-right: 0; }
.row.good { color: #7ee08a; }

/* a section's title */
.row.heading {
	height: 18.5dp;
	line-height: 18.5dp;
	margin-top: 7.7dp;
	margin-bottom: 3.1dp;
	font-size: 12.3dp;
	font-weight: 700;
	color: #8fa3d6;
	letter-spacing: 0.8dp;
}
.row.heading:first-child { margin-top: 0; }

/* a big value to read out (a host's address) */
.row.big {
	height: 33.9dp;
	line-height: 33.9dp;
	font-size: 26.2dp;
	font-style: italic;
	font-weight: 700;
	color: #ffd23f;
}

#note {
	margin-top: 6.2dp;
	height: 61.6dp;           /* four lines; the help texts are written to fit */
	line-height: 15.4dp;
	overflow: hidden;
	font-size: 13.9dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint {
	margin-top: 6.2dp;
	height: 16.9dp;
	line-height: 16.9dp;
	font-size: 12.8dp;   /* (0.75: Russian's keys line fits whole) */
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
}

.key { color: #dfe7fb; }

/* the version and date, small, under the hint */
#ver {
	margin-top: 3.1dp;
	height: 13.9dp;
	line-height: 13.9dp;
	font-size: 11.6dp;
	font-weight: 500;
	color: #5f6f9c;
	white-space: nowrap;
}
